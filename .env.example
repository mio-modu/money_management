# 비워 두면 앱은 "로컬 모드"로 돈다 — 브라우저 안에만 저장되고 서버로 아무것도 안 나간다.
# 아래 두 값을 채우면 같은 코드가 Supabase 로 붙는다. (supabase/migrations 를 먼저 실행)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버에서 규칙을 돌리려면 서비스 키가 필요하다(RLS 를 우회해 전체 사용자를 읽는다).
# 비워 두면 평가는 앱을 열 때 클라이언트에서 돈다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 자정 규칙 평가 cron 보호용. Vercel Cron 이 Authorization: Bearer <값> 으로 호출한다.
# vercel.json 의 스케줄은 UTC 15:05 = 한국 시간 자정 5분.
CRON_SECRET=
